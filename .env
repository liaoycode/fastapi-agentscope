# APP
APP_NAME=fastapi-demo
APP_HOST=0.0.0.0
APP_PORT=8000

# nacos
NACOS_ENABLE=false
NACOS_SERVER=127.0.0.1:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_NAMESPACE=eadmin
NACOS_GROUP=dev
NACOS_SERVER_NAME=fastapi-demo

#database
DB_ENABLE=true
#DATABASE_URL=postgresql+asyncpg://postgres:123%40123@127.0.0.1:5432/agent-test
DATABASE_URL=postgresql+asyncpg://postgres:123%40123@host.docker.internal:5432/agent-test
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_DETAIL_DEBUG=False

#redis
REDIS_ENABLE=true
REDIS_URL=redis://:oE3cX1cO6kA7@127.0.0.1:16379/0
REDIS_MAX_CONNECTIONS=10

#llm
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_API_KEY=sk-cp-oXM8qvNluGnKoK3894htf8LsbdlRM-md6hdIY_m-p6D2Y602C5AwP6XBkJPJ87GbiRnMCYjuzX8iWBHvYU2ceudkOxkM5TFWcacvwsgAh-Zvc1DxW_7WT5I
LLM_MODEL_NAME=MiniMax-M2.7
#LLM_BASE_URL=http://moma.hq.cmcc/largemodel/moma/api/v3
#LLM_API_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJhcGlfa2V5IjoiNjljZjk5NTEyOGVjMDIxMjQyZTQ3NWQxIiwiZXhwIjoxODU1NDQzNjI4MjM2NzQsInRpbWVzdGFtcCI6MTc3NTcyMjg3NH0.MiI7I6-jFKQz3axrtyt4_a1-5N4tVgbvzDuHRNBljAA
#LLM_MODEL_NAME=deepseek/deepseek-v4-flash
## 模型上下文窗口大小（触发压缩阈值 = AGENT_CONTEXT_TRIGGER_RATIO * LLM_CONTEXT_SIZE）
LLM_CONTEXT_SIZE=128000

#agentscope
AGENT_ENABLE=true
## 对应app.infrastructure.prompt.prompts里面的文件名,不同文件名不同系统提示词
AGENT_SYSTEM_PROMPT=default_system
AGENT_WORKSPACE_IMAGE=python:3.11-slim
# 公共skill所在的目录
AGENT_SKILL_PUBLIC_DIR=./skills
## 沙箱容器内工作根目录(默认 /sandbox,跟 agentscope DockerWorkspace 一致)。
## 同时是 PersonalSkillLoader 拼 Skill.dir 给 LLM 看的依据 —— LLM 拿到后可
## 直接在 sandbox 内 cd 进去。
AGENT_WORKSPACE_CONTAINER_DIR=/sandbox
## public / personal skill 在 sandbox 内的子目录名(拼到 container_dir 下)
AGENT_SKILL_PUBLIC_SUBDIR=skills
AGENT_SKILL_PERSONAL_SUBDIR=personal_skills
AGENT_CONTEXT_TRIGGER_RATIO=0.6
AGENT_CONTEXT_RESERVE_RATIO=0.2
## per-user sandbox + hardening
# docker desktop
#AGENT_DOCKER_HOST=unix:///home/liaoyun/.docker/desktop/docker.sock
# docker dockerd
#AGENT_DOCKER_HOST=unix:///var/run/docker.sock
AGENT_DOCKER_TLS_VERIFY=false
AGENT_USER_VOLUME_PREFIX=agent-sandbox
AGENT_WORKSPACE_PIDS_LIMIT=512
AGENT_WORKSPACE_CPU_SHARES=512
AGENT_WORKSPACE_MEM_LIMIT=256m
# 打开沙箱容器的python日志输出
AGENT_WORKSPACE_PYTHON_UNBUFFERED=true
AGENT_WORKSPACE_IDLE_TTL_SECONDS=600
AGENT_WORKSPACE_REAPER_INTERVAL_SECONDS=60
AGENT_SNAPSHOT_ENABLED=true
AGENT_SNAPSHOT_MAX_AUTO_PER_USER=5
